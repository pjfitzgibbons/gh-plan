{
  "name": "gh-plan",
  "displayName": "GH Plan",
  "description": "Redmine's Next up query in a narrow sidebar panel; each issue opens in place, starts in its own worktree, ships from its review, and finishes after its merge.",
  "version": "0.5.0",
  "publisher": "pjfitzgibbons",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "vscode": "^1.90.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "scripts": { "test": "node --test", "lint": "eslint ." },
  "devDependencies": { "@eslint/js": "9.39.5", "eslint": "9.39.5", "globals": "16.5.0" },
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "plan", "title": "Plan", "icon": "media/plan.svg" }]
    },
    "views": {
      "plan": [{ "type": "webview", "id": "plan.nextUp", "name": "Next up" }]
    },
    "commands": [
      { "command": "plan.refresh", "title": "Refresh", "category": "Plan", "icon": "$(refresh)" },
      { "command": "plan.openChanges", "title": "Go", "category": "Plan", "icon": "$(diff-multiple)" },
      { "command": "plan.runPr", "title": "Ship", "category": "Plan", "icon": "$(rocket)" }
    ],
    "menus": {
      "view/title": [{ "command": "plan.refresh", "when": "view == plan.nextUp", "group": "navigation" }],
      "editor/title": [
        { "command": "plan.openChanges", "when": "resourcePath =~ /\\/\\.tmp\\/[1-9][0-9]*\\/(commit\\.txt|pr-body\\.md|replies\\/[0-9]+\\.md)$/", "group": "navigation" },
        { "command": "plan.runPr", "when": "plan.shipReady && (activeEditor == multiDiffEditor || resourcePath =~ /\\/\\.tmp\\/[1-9][0-9]*\\/(commit\\.txt|pr-body\\.md|replies\\/[0-9]+\\.md)$/)", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "plan.openChanges", "when": "resourcePath =~ /\\/\\.tmp\\/[1-9][0-9]*\\/(commit\\.txt|pr-body\\.md|replies\\/[0-9]+\\.md)$/" },
        { "command": "plan.runPr", "when": "plan.shipReady" }
      ]
    },
    "taskDefinitions": [
      { "type": "plan", "required": ["issue"], "properties": { "issue": { "type": "integer", "description": "The issue pr ships." } } }
    ],
    "configuration": {
      "title": "GH Plan",
      "properties": {
        "plan.redmineUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3010",
          "description": "The Redmine the panel reads."
        },
        "plan.project": {
          "type": "string",
          "default": "plan",
          "description": "The identifier of the project whose query the panel shows."
        },
        "plan.query": {
          "type": "string",
          "default": "Next up",
          "description": "The name of the saved issue query the panel shows, in its order."
        },
        "plan.projectMarkers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": { "gh-plan": "Pl", "tempotag": "tt", "ms-security-docs": "ms" },
          "description": "The short marker each row shows for its repo, by Redmine project identifier. A project not listed shows the first two letters of its identifier."
        },
        "plan.checkouts": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": { "gh-plan": "~/programming/gh-plan", "tempotag": "~/programming/tempotag" },
          "description": "The main checkout of each repo, by Redmine project identifier. Start makes an issue's worktree beside it, in <repo>.worktrees/<n>."
        },
        "plan.disposable": {
          "type": "array",
          "items": { "type": "string" },
          "default": [".tmp/", "node_modules/", ".venv/", "__pycache__/", ".pytest_cache/", ".coverage", ".ruby-lsp/", "htmlcov/", "dist/", "build/"],
          "description": "The ignored files Done may delete with an issue's worktree, by name at any depth; name/ is a folder. Done refuses a worktree holding any other ignored file."
        },
        "plan.pr": {
          "type": "string",
          "default": "~/.local/bin/pr",
          "description": "The pr script Ship runs, by its path."
        },
        "plan.keychainService": {
          "type": "string",
          "default": "redmine-gh-plan",
          "description": "The macOS Keychain item (service name) that holds your Redmine API key."
        },
        "plan.sysKeychainService": {
          "type": "string",
          "default": "redmine-sys-api",
          "description": "The macOS Keychain item (service name) that holds the key of Redmine's repository web service, which Done uses to fetch the commits after a merge."
        }
      }
    }
  }
}
