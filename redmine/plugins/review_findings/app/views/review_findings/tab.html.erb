<h2>Findings<% if @issue %> for <%= link_to_issue @issue %><% end %></h2>
<% if @issue %><p><%= link_to 'All issues', project_review_findings_path(@project) %></p><% end %>
<% if @findings.empty? %>
<p class="nodata"><%= @issue ? 'No review yet.' : 'No issue has a review yet.' %></p>
<% else %>
<div class="autoscroll">
<table class="list review-findings">
  <thead><tr><th>Issue</th><th>Finding</th><th>Raised</th><th>Status</th><th>Visibility</th>
    <th>Severity</th><th>Summary</th></tr></thead>
  <tbody>
  <% @findings.each_with_index do |events, i| %>
    <% latest = events.first %>
    <% raised = events.reverse.find { |f| f.source == 'review' } || events.last %>
    <% answer = events.find { |f| f.source == 'outcomes' } %>
    <tr class="<%= cycle('odd', 'even') %><%= ' open-to-fix' if i < @open %>">
      <td><%= link_to_issue latest.issue, tracker: false, subject: false %></td>
      <td><%= latest.key %></td>
      <td><%= raised.round %></td>
      <td><%= i < @open ? 'Open to fix' : latest.status %><% if latest.round != raised.round %> (round <%= latest.round %>)<% end %></td>
      <td><%= latest.visibility %></td>
      <td><%= latest.severity %></td>
      <td>
        <strong><%= raised.summary %></strong>
        <% if raised.body.present? %><%= simple_format(h(raised.body)) %><% end %>
        <% if answer&.justification.present? %><%= simple_format(h(answer.justification)) %><% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<% end %>
