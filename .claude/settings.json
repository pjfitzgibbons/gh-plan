{
  "attribution": {
    "commit": "Assisted-by: Claude:claude-opus-5-5",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 .claude/hooks/test_no_ai_attribution.py:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh api rate_limit:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/.netrc)",
      "Read(./**/*.secrets.json)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no_ai_attribution.py"
          }
        ]
      }
    ]
  }
}
